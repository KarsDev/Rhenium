/*
    Portable key / mouse-button codes used by win.cpp (Identical on Windows, Linux, MacOS).
    Pass these to isKeyPressed(code)
    Letters and digits equal their ASCII codes
    Maximum code is 255. Code 0 means 'unknown key' and is never reported.
*/
namespace Keys:
    global KEY_NONE            = 0
    global MOUSE_LEFT          = 1
    global MOUSE_RIGHT         = 2
    global MOUSE_MIDDLE        = 4
